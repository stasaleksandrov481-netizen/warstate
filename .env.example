# Required application / Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy alias supported when publishable key is unavailable
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
# Legacy alias supported
SUPABASE_SERVICE_ROLE_KEY=

# Required Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_MINI_APP_SHORT_NAME=
TELEGRAM_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app

# Optional game configuration
BEGINNER_ISLAND_CHAT_ID=

# Optional but recommended. If unavailable, v2.0 uses a local serverless fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional manual backup endpoints only. Vercel Cron is NOT required in v2.0.
CRON_SECRET=
