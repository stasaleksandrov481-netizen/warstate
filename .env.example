# Public app URL after Vercel deploy
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app

# Local browser demo without Telegram/Supabase
NEXT_PUBLIC_DEMO_MODE=true

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Legacy anon key is also supported if your project uses it
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Newer secret key can be used instead of service role
SUPABASE_SECRET_KEY=

# Telegram bot
TELEGRAM_BOT_TOKEN=123456:ABCDEF
TELEGRAM_BOT_USERNAME=GroupWarsBot
TELEGRAM_MINI_APP_SHORT_NAME=play
TELEGRAM_WEBHOOK_SECRET=replace_with_random_secret
